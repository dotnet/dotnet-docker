<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="dotnet-public" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-public/nuget/v3/index.json" />
    <!--
      Needed for the Blazor WASM workload test while .NET 11 is pre-release: dotnet-public does not have
      microsoft.net.workload.emscripten.current.manifest-11.0.100-rc.3 (11.0.100-rc.3.26522.148).
      Remove this feed once the SDK is updated to the .NET 11 GA version and its workload manifests are
      available from dotnet-public.
    -->
    <add key="dotnet11" value="https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet11/nuget/v3/index.json" />
  </packageSources>
</configuration>
