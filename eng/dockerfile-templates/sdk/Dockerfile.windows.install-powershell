{{
    set dotnetVersion to join(slice(split(PRODUCT_VERSION, "."), 0, 2), ".") ^
    set rootDir to "\" ^
    set nupkgFile to "PowerShell.Windows.x64.$powershell_version.nupkg" ^
    set powershellVersion to VARIABLES[cat("powershell|", dotnetVersion, "|build-version")] ^
    _ Refer to the version through PowerShell variables so it is only written once. Internal storage
      uses a dashed version (e.g. v7-5-11-nuget) in its directory names. ^
    set replace(subject, old, new) to:{{ return join(split(subject, old), new) }} ^
    set dashedVersion to replace(powershellVersion, ".", "-") ^
    set baseUrl to replace(VARIABLES[cat("powershell|", dotnetVersion, "|base-url")], powershellVersion, "$powershell_version") ^
    set useDashedVersion to find(baseUrl, dashedVersion) >= 0 ^
    set baseUrl to replace(baseUrl, dashedVersion, "$powershell_url_version") ^
    set url to cat(baseUrl, "/", nupkgFile) ^
    set shaFunction to VARIABLES[cat("powershell|", dotnetVersion, "|sha-function")]
}}# Install PowerShell global tool
$powershell_version = '{{powershellVersion}}'; `
{{if useDashedVersion:$powershell_url_version = $powershell_version.Replace('.', '-'); `
}}{{InsertTemplate("../Dockerfile.windows.download-files", ["files": [[
    "out-file": nupkgFile,
    "url": url
]]])}}; `
{{InsertTemplate("../Dockerfile.windows.validate-checksum", [
    "file": nupkgFile,
    "sha": VARIABLES[cat("powershell|", dotnetVersion, "|Windows|x64|sha")],
    "sha-function": shaFunction,
    "sha-var-name": cat("$powershell_sha", shaFunction)
])}}; `
& {{rootDir}}dotnet\dotnet tool install --add-source . --tool-path {{rootDir}}powershell --version $powershell_version PowerShell.Windows.x64; `
& {{rootDir}}dotnet\dotnet nuget locals all --clear; `
Remove-Item -Force {{nupkgFile}}; `
Remove-Item -Path {{rootDir}}powershell\.store\powershell.windows.x64\$powershell_version\powershell.windows.x64\$powershell_version\{{lcase(nupkgFile)}} -Force;
